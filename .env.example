# =============================================================
# Shopigent 환경 설정
# 이 파일을 .env로 복사하고 실제 값을 채워주세요
# cp .env.example .env
# =============================================================

# ----- LLM 설정 -----
LLM_PRIMARY_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_PRIMARY_MODEL=ollama/mistral  # 로컬 실행 시

ANTHROPIC_API_KEY=sk-ant-여기에_API_키_입력
# OPENAI_API_KEY=sk-여기에_API_키_입력  # fallback 사용 시

# ----- 네이버 쇼핑 API -----
NAVER_CLIENT_ID=여기에_클라이언트_ID_입력
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿_입력

# ----- 이메일 설정 -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=앱_비밀번호_입력  # Gmail 앱 비밀번호 (2단계 인증 필요)
REPORT_EMAIL_TO=your@gmail.com

# ----- 애플리케이션 -----
DATABASE_URL=sqlite+aiosqlite:///./data/shopigent.db
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# ----- 스크래핑 설정 -----
SCRAPE_DELAY_MIN=2.0        # 최소 요청 딜레이 (초)
SCRAPE_DELAY_MAX=8.0        # 최대 요청 딜레이 (초)
MAX_CONCURRENT_SCRAPERS=3   # 동시 스크래퍼 수

# ----- LLM 비용 관리 -----
LLM_MONTHLY_BUDGET_USD=10.0  # 월 LLM 사용 예산 (달러)
